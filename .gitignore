```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc.*
.Python
env/
venv/
.venv/
.venv.bak/
pip-log.txt
pip-selfcheck.json
.python-version

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment specific
.env
.env.local
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage
*.coveragerc

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# Temporary files
*.tmp
*.temp
.DS_Store
*.bak
*.backup

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```